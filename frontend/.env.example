# ==============================================================================
# SmartScan Stay — Frontend Environment Variables Example
# ==============================================================================
# За локална разработка копирайте този файл като .env или .env.local:
#   cp .env.example .env.local
#
# Във Vercel (Project Settings -> Environment Variables) въведете продукционните стойности.

# Supabase (от Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<your-project>.supabase.co/auth/v1/.well-known/jwks.json

# Internal Backend Proxy
# Локално: http://127.0.0.1:8000
# Във Vercel (Production): https://smartscan-zo2e.onrender.com (или вашият Render URL)
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
BACKEND_PROXY_SECRET=your_64_character_hex_secret_here

# Canonical Public Domain (за QR кодове и редиректи)
# Локално: http://localhost:3000
# Във Vercel (Production): https://<your-project>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe Configuration (Test Mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_STRIPE_PRICE_ID_STAY=price_...
