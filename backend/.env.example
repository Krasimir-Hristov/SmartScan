# ==============================================================================
# SmartScan Stay — Backend Environment Variables Example (.env)
# ==============================================================================
# Локално: копирайте като backend/.env
# В Render.com: въведете тези променливи в Environment Settings на Web Service-а

# Server Environment
# Локално: development
# В Render: production
ENVIRONMENT=development
PORT=8000

# CORS & Allowed Origins (запетая-разделен списък за поддръжка на Vercel и localhost)
# Локално: http://localhost:3000,http://127.0.0.1:3000
# В Render: https://<your-project>.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend URL (за Stripe пренасочвания)
# Локално: http://localhost:3000
# В Render: https://<your-project>.vercel.app
FRONTEND_URL=http://localhost:3000

# Supabase Credentials (от Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<your-project>.supabase.co/auth/v1/.well-known/jwks.json

# OpenRouter (за AI Консиерж / Gemini 2.5 Flash)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-2.5-flash

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID_STAY=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Shared Proxy Secret (трябва да съвпада с BACKEND_PROXY_SECRET във frontend)
BACKEND_PROXY_SECRET=your_64_character_hex_secret_here
